# Copy to .env. Generate secrets with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://qlyno:qlyno_dev_password@localhost:5432/qlyno_lab?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-64-random-characters
JWT_RESET_SECRET=replace-with-a-different-at-least-64-character-secret
JWT_ISSUER=qlyno-laboratory-api
JWT_AUDIENCE=qlyno-laboratory-portal
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=14
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
PASSWORD_PEPPER=replace-with-a-random-pepper
LOG_LEVEL=info

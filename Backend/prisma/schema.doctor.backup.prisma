generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountStatus {
  ACTIVE
  INVITED
  SUSPENDED
  ARCHIVED
}

enum WorkplaceType {
  SOLO_PRACTICE
  CLINIC
  HOSPITAL
  ONLINE_PRACTICE
}

enum ShiftType {
  CLINIC_OPD
  HOSPITAL_DUTY
  WARD_ROUND
  ON_CALL
  ONLINE_CONSULTATION
  BLOCKED
  LEAVE
}

enum ShiftStatus {
  DRAFT
  UPCOMING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RoomStatus {
  ACTIVE
  MAINTENANCE
  INACTIVE
}

enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  REFUNDED
  CANCELLED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  WAITING
  IN_CONSULTATION
  COMPLETED
  LATE
  CANCELLED
  NO_SHOW
  RESCHEDULED
}

enum AppointmentMode {
  IN_PERSON
  VIDEO
  HOME
  HOSPITAL
}

enum EncounterStatus {
  BOOKED
  CONFIRMED
  CHECKED_IN
  WAITING
  CONSULTATION_STARTED
  CONSULTATION_COMPLETED
  FOLLOW_UP_REQUIRED
  CLOSED
  CANCELLED
  NO_SHOW
  RESCHEDULED
  EMERGENCY_TRANSFER
  REFERRED
  ADMITTED
}

enum EncounterType {
  NEW_CONSULTATION
  FOLLOW_UP
  TELECONSULTATION
  PROCEDURE_REVIEW
  INPATIENT_ROUND
  EMERGENCY
}

enum AllergySeverity {
  MILD
  MODERATE
  SEVERE
}

enum DiagnosisType {
  PRIMARY
  SECONDARY
  PROVISIONAL
  CONFIRMED
}

enum DiagnosisStatus {
  ACTIVE
  RESOLVED
  CHRONIC
  RULED_OUT
}

enum PrescriptionStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum OrderType {
  LABORATORY
  RADIOLOGY
  EXTERNAL_REPORT
}

enum OrderStatus {
  PENDING
  ORDERED
  SAMPLE_COLLECTED
  IN_PROGRESS
  SCHEDULED
  RESULT_READY
  CRITICAL
  REVIEWED
  CANCELLED
}

enum Priority {
  LOW
  ROUTINE
  MEDIUM
  HIGH
  URGENT
  CRITICAL
}

enum FollowUpType {
  TIME_BASED
  EVENT_BASED
}

enum FollowUpStatus {
  UPCOMING
  DUE_TODAY
  OVERDUE
  COMPLETED
  CANCELLED
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ReferralType {
  INTERNAL
  EXTERNAL
  HOSPITAL_DEPARTMENT
}

enum ReferralStatus {
  DRAFT
  SENT
  ACCEPTED
  APPOINTMENT_BOOKED
  CONSULTED
  COMPLETED
  DECLINED
}

enum ConversationType {
  PATIENT
  CLINIC_STAFF
  DOCTOR
  REFERRAL
}

enum NotificationSeverity {
  CRITICAL
  ACTION_REQUIRED
  REMINDER
  INFORMATION
}

model UserAccount {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique
  phone        String?
  passwordHash String?
  status       AccountStatus @default(ACTIVE)
  lastLoginAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doctorProfile   DoctorProfile?
  staffProfile    StaffProfile?
  notifications   Notification[]
  auditEvents     AuditEvent[]
  messages        Message[]
  taskAssignments TaskAssignee[]

  @@map("user_accounts")
}

model DoctorProfile {
  id                 String   @id @default(uuid()) @db.Uuid
  userAccountId      String   @unique @db.Uuid
  fullName           String
  specialty          String
  qualifications     String?
  experienceYears    Int?
  registrationNumber String?
  languages          String[] @default([])
  bio                String?
  consultationFee    Decimal? @db.Decimal(10, 2)
  publicProfileSlug  String?  @unique
  profilePhotoUrl    String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  userAccount       UserAccount           @relation(fields: [userAccountId], references: [id], onDelete: Cascade)
  workplaces        DoctorWorkplace[]
  primaryPatients   Patient[]             @relation("PrimaryDoctorPatients")
  appointments      Appointment[]
  encounters        Encounter[]
  prescriptions     Prescription[]
  orders            InvestigationOrder[]
  shifts            DoctorShift[]
  serviceLinks      ClinicServiceDoctor[]
  followUps         FollowUp[]
  referralsMade     Referral[]            @relation("ReferralMadeByDoctor")
  referralsReceived Referral[]            @relation("ReferralReceivedByDoctor")
  articles          DoctorContent[]

  @@map("doctor_profiles")
}

model StaffProfile {
  id            String        @id @default(uuid()) @db.Uuid
  userAccountId String?       @unique @db.Uuid
  fullName      String
  role          String
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  userAccount UserAccount?     @relation(fields: [userAccountId], references: [id], onDelete: SetNull)
  memberships StaffWorkplace[]

  @@map("staff_profiles")
}

model Workplace {
  id        String        @id @default(uuid()) @db.Uuid
  name      String
  type      WorkplaceType
  legalName String?
  phone     String?
  email     String?
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  locations     WorkplaceLocation[]
  doctors       DoctorWorkplace[]
  staff         StaffWorkplace[]
  patients      PatientWorkplace[]
  appointments  Appointment[]
  encounters    Encounter[]
  prescriptions Prescription[]
  orders        InvestigationOrder[]
  shifts        DoctorShift[]
  services      ClinicService[]
  rooms         ClinicRoom[]
  invoices      BillingInvoice[]
  inventory     InventoryItem[]
  followUps     FollowUp[]
  tasks         Task[]
  referrals     Referral[]
  conversations Conversation[]
  notifications Notification[]

  @@map("workplaces")
}

model WorkplaceLocation {
  id           String   @id @default(uuid()) @db.Uuid
  workplaceId  String   @db.Uuid
  name         String
  addressLine1 String
  addressLine2 String?
  city         String
  state        String?
  country      String   @default("India")
  postalCode   String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workplace    Workplace     @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  rooms        ClinicRoom[]

  @@index([workplaceId])
  @@map("workplace_locations")
}

model ClinicRoom {
  id          String     @id @default(uuid()) @db.Uuid
  workplaceId String     @db.Uuid
  locationId  String?    @db.Uuid
  name        String
  roomType    String     @default("Consultation")
  status      RoomStatus @default(ACTIVE)
  notes       String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workplace    Workplace          @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  location     WorkplaceLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  appointments Appointment[]

  @@unique([workplaceId, name])
  @@index([locationId])
  @@map("clinic_rooms")
}

model ClinicService {
  id              String   @id @default(uuid()) @db.Uuid
  workplaceId     String   @db.Uuid
  name            String
  description     String?
  durationMinutes Int      @default(20)
  price           Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  workplace       Workplace             @relation(fields: [workplaceId], references: [id], onDelete: Cascade)
  eligibleDoctors ClinicServiceDoctor[]

  @@unique([workplaceId, name])
  @@index([workplaceId, isActive])
  @@map("clinic_services")
}

model ClinicServiceDoctor {
  id        String   @id @default(uuid()) @db.Uuid
  serviceId String   @db.Uuid
  doctorId  String   @db.Uuid
  fee       Decimal? @db.Decimal(10, 2)
  createdAt DateTime @default(now())

  service ClinicService @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  doctor  DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([serviceId, doctorId])
  @@index([doctorId])
  @@map("clinic_service_doctors")
}

model DoctorWorkplace {
  id           String        @id @default(uuid()) @db.Uuid
  doctorId     String        @db.Uuid
  workplaceId  String        @db.Uuid
  doctorRole   String
  department   String?
  scheduleNote String?
  isPrimary    Boolean       @default(false)
  status       AccountStatus @default(ACTIVE)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  workplace Workplace     @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@unique([doctorId, workplaceId])
  @@index([workplaceId])
  @@map("doctor_workplaces")
}

model DoctorShift {
  id             String      @id @default(uuid()) @db.Uuid
  doctorId       String      @db.Uuid
  workplaceId    String      @db.Uuid
  startsAt       DateTime
  endsAt         DateTime
  shiftType      ShiftType
  status         ShiftStatus @default(UPCOMING)
  bookingEnabled Boolean     @default(true)
  slotMinutes    Int         @default(20)
  bufferMinutes  Int         @default(0)
  bookingLimit   Int?
  recurrenceRule String?
  note           String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  workplace Workplace     @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@index([doctorId, startsAt])
  @@index([workplaceId, startsAt])
  @@map("doctor_shifts")
}

model StaffWorkplace {
  id          String        @id @default(uuid()) @db.Uuid
  staffId     String        @db.Uuid
  workplaceId String        @db.Uuid
  role        String
  status      AccountStatus @default(ACTIVE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  staff     StaffProfile @relation(fields: [staffId], references: [id], onDelete: Cascade)
  workplace Workplace    @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@unique([staffId, workplaceId])
  @@index([workplaceId])
  @@map("staff_workplaces")
}

model RolePermission {
  id        String   @id @default(uuid()) @db.Uuid
  role      String
  resource  String
  canRead   Boolean  @default(false)
  canCreate Boolean  @default(false)
  canUpdate Boolean  @default(false)
  canDelete Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([role, resource])
  @@map("role_permissions")
}

model Patient {
  id              String    @id @default(uuid()) @db.Uuid
  qlynoId         String    @unique
  fullName        String
  gender          Gender    @default(UNKNOWN)
  dateOfBirth     DateTime? @db.Date
  phone           String?
  email           String?
  bloodGroup      String?
  primaryDoctorId String?   @db.Uuid
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  primaryDoctor DoctorProfile?       @relation("PrimaryDoctorPatients", fields: [primaryDoctorId], references: [id], onDelete: SetNull)
  workplaces    PatientWorkplace[]
  allergies     PatientAllergy[]
  conditions    PatientCondition[]
  medications   PatientMedication[]
  appointments  Appointment[]
  encounters    Encounter[]
  vitals        VitalSet[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  orders        InvestigationOrder[]
  followUps     FollowUp[]
  invoices      BillingInvoice[]
  tasks         Task[]
  referrals     Referral[]
  documents     DocumentAsset[]
  conversations Conversation[]
  notifications Notification[]

  @@index([fullName])
  @@index([primaryDoctorId])
  @@map("patients")
}

model PatientWorkplace {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String   @db.Uuid
  workplaceId String   @db.Uuid
  localMrn    String?
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workplace Workplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@unique([patientId, workplaceId])
  @@unique([workplaceId, localMrn])
  @@map("patient_workplaces")
}

model PatientAllergy {
  id        String          @id @default(uuid()) @db.Uuid
  patientId String          @db.Uuid
  substance String
  severity  AllergySeverity
  reaction  String?
  notedAt   DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_allergies")
}

model PatientCondition {
  id        String          @id @default(uuid()) @db.Uuid
  patientId String          @db.Uuid
  name      String
  icdCode   String?
  status    DiagnosisStatus @default(ACTIVE)
  notedAt   DateTime        @default(now())
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_conditions")
}

model PatientMedication {
  id        String    @id @default(uuid()) @db.Uuid
  patientId String    @db.Uuid
  name      String
  strength  String?
  frequency String?
  startedOn DateTime? @db.Date
  stoppedOn DateTime? @db.Date
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@map("patient_medications")
}

model Appointment {
  id                 String            @id @default(uuid()) @db.Uuid
  patientId          String            @db.Uuid
  doctorId           String            @db.Uuid
  workplaceId        String            @db.Uuid
  locationId         String?           @db.Uuid
  roomId             String?           @db.Uuid
  scheduledAt        DateTime
  durationMinutes    Int               @default(20)
  mode               AppointmentMode   @default(IN_PERSON)
  status             AppointmentStatus @default(SCHEDULED)
  reason             String?
  checkedInAt        DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancellationReason String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  patient    Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor     DoctorProfile      @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  workplace  Workplace          @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  location   WorkplaceLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  room       ClinicRoom?        @relation(fields: [roomId], references: [id], onDelete: SetNull)
  encounters Encounter[]
  tasks      Task[]
  invoice    BillingInvoice?

  @@index([doctorId, scheduledAt])
  @@index([workplaceId, scheduledAt])
  @@index([patientId])
  @@index([roomId, scheduledAt])
  @@map("appointments")
}

model Encounter {
  id             String          @id @default(uuid()) @db.Uuid
  patientId      String          @db.Uuid
  doctorId       String          @db.Uuid
  workplaceId    String          @db.Uuid
  appointmentId  String?         @db.Uuid
  type           EncounterType
  status         EncounterStatus @default(BOOKED)
  chiefComplaint String?
  history        String?
  examination    String?
  clinicalNotes  String?
  assessment     String?
  treatmentPlan  String?
  advice         String?
  followUpAdvice String?
  startedAt      DateTime?
  completedAt    DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  patient       Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor        DoctorProfile        @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  workplace     Workplace            @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  appointment   Appointment?         @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  vitals        VitalSet[]
  diagnoses     Diagnosis[]
  prescriptions Prescription[]
  orders        InvestigationOrder[]
  followUps     FollowUp[]
  documents     DocumentAsset[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@index([workplaceId, createdAt])
  @@map("encounters")
}

model VitalSet {
  id              String   @id @default(uuid()) @db.Uuid
  patientId       String   @db.Uuid
  encounterId     String?  @db.Uuid
  recordedById    String?  @db.Uuid
  recordedAt      DateTime @default(now())
  systolicBp      Int?
  diastolicBp     Int?
  pulse           Int?
  temperatureF    Decimal? @db.Decimal(5, 2)
  spo2            Int?
  respiratoryRate Int?
  weightKg        Decimal? @db.Decimal(6, 2)
  heightCm        Decimal? @db.Decimal(6, 2)
  bmi             Decimal? @db.Decimal(5, 2)
  bloodGlucose    Decimal? @db.Decimal(7, 2)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([patientId, recordedAt])
  @@index([encounterId])
  @@map("vital_sets")
}

model Diagnosis {
  id          String          @id @default(uuid()) @db.Uuid
  patientId   String          @db.Uuid
  encounterId String?         @db.Uuid
  icdCode     String?
  description String
  type        DiagnosisType   @default(PROVISIONAL)
  status      DiagnosisStatus @default(ACTIVE)
  notes       String?
  diagnosedAt DateTime        @default(now())
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  patient   Patient    @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)

  @@index([patientId, diagnosedAt])
  @@index([encounterId])
  @@map("diagnoses")
}

model Prescription {
  id          String             @id @default(uuid()) @db.Uuid
  patientId   String             @db.Uuid
  doctorId    String             @db.Uuid
  workplaceId String             @db.Uuid
  encounterId String?            @db.Uuid
  status      PrescriptionStatus @default(DRAFT)
  advice      String?
  issuedAt    DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  patient   Patient                  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  workplace Workplace                @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  encounter Encounter?               @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  medicines PrescriptionMedication[]

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
  @@map("prescriptions")
}

model PrescriptionMedication {
  id             String   @id @default(uuid()) @db.Uuid
  prescriptionId String   @db.Uuid
  medicineName   String
  strength       String?
  form           String?
  dose           String?
  route          String?
  frequency      String?
  duration       String?
  quantity       String?
  refillCount    Int      @default(0)
  instructions   String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  @@index([prescriptionId])
  @@map("prescription_medications")
}

model InvestigationOrder {
  id          String      @id @default(uuid()) @db.Uuid
  patientId   String      @db.Uuid
  doctorId    String      @db.Uuid
  workplaceId String      @db.Uuid
  encounterId String?     @db.Uuid
  type        OrderType
  title       String
  status      OrderStatus @default(ORDERED)
  priority    Priority    @default(ROUTINE)
  source      String?
  orderedAt   DateTime    @default(now())
  scheduledAt DateTime?
  reviewedAt  DateTime?
  doctorNotes String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  workplace Workplace     @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  encounter Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  report    Report?
  tasks     Task[]

  @@index([patientId, orderedAt])
  @@index([workplaceId, status])
  @@index([doctorId, orderedAt])
  @@map("investigation_orders")
}

model Report {
  id             String      @id @default(uuid()) @db.Uuid
  orderId        String      @unique @db.Uuid
  status         OrderStatus @default(RESULT_READY)
  resultSummary  String?
  interpretation String?
  isAbnormal     Boolean     @default(false)
  isCritical     Boolean     @default(false)
  documentUrl    String?
  resultAt       DateTime?
  reviewedAt     DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  order     InvestigationOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  values    ReportValue[]
  documents DocumentAsset[]

  @@index([status])
  @@map("reports")
}

model ReportValue {
  id             String   @id @default(uuid()) @db.Uuid
  reportId       String   @db.Uuid
  name           String
  value          String
  unit           String?
  referenceRange String?
  isAbnormal     Boolean  @default(false)
  isCritical     Boolean  @default(false)
  createdAt      DateTime @default(now())

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@map("report_values")
}

model DocumentAsset {
  id          String   @id @default(uuid()) @db.Uuid
  patientId   String?  @db.Uuid
  encounterId String?  @db.Uuid
  reportId    String?  @db.Uuid
  title       String
  mimeType    String?
  storagePath String?
  externalUrl String?
  notes       String?
  uploadedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  patient   Patient?   @relation(fields: [patientId], references: [id], onDelete: SetNull)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  report    Report?    @relation(fields: [reportId], references: [id], onDelete: SetNull)

  @@index([patientId])
  @@index([encounterId])
  @@index([reportId])
  @@map("document_assets")
}

model FollowUp {
  id           String         @id @default(uuid()) @db.Uuid
  patientId    String         @db.Uuid
  doctorId     String         @db.Uuid
  workplaceId  String         @db.Uuid
  encounterId  String?        @db.Uuid
  type         FollowUpType   @default(TIME_BASED)
  status       FollowUpStatus @default(UPCOMING)
  dueAt        DateTime?
  triggerEvent String?
  reason       String
  owner        String         @default("Doctor")
  completedAt  DateTime?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  patient   Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor    DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  workplace Workplace     @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  encounter Encounter?    @relation(fields: [encounterId], references: [id], onDelete: SetNull)
  tasks     Task[]

  @@index([patientId, dueAt])
  @@index([workplaceId, status])
  @@map("follow_ups")
}

model BillingInvoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique
  patientId     String        @db.Uuid
  workplaceId   String        @db.Uuid
  appointmentId String?       @unique @db.Uuid
  status        PaymentStatus @default(UNPAID)
  subtotal      Decimal       @default(0) @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  tax           Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @default(0) @db.Decimal(10, 2)
  notes         String?
  issuedAt      DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workplace   Workplace    @relation(fields: [workplaceId], references: [id], onDelete: Restrict)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  payments    PaymentTxn[]

  @@index([patientId, issuedAt])
  @@index([workplaceId, status])
  @@map("billing_invoices")
}

model PaymentTxn {
  id          String        @id @default(uuid()) @db.Uuid
  invoiceId   String        @db.Uuid
  amount      Decimal       @db.Decimal(10, 2)
  method      String
  status      PaymentStatus @default(PAID)
  reference   String?
  collectedAt DateTime      @default(now())
  createdAt   DateTime      @default(now())

  invoice BillingInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@map("payment_txns")
}

model InventoryItem {
  id           String    @id @default(uuid()) @db.Uuid
  workplaceId  String    @db.Uuid
  name         String
  category     String
  sku          String?
  stockOnHand  Int       @default(0)
  reorderLevel Int       @default(0)
  unit         String?
  expiryDate   DateTime? @db.Date
  supplier     String?
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workplace Workplace @relation(fields: [workplaceId], references: [id], onDelete: Cascade)

  @@unique([workplaceId, sku])
  @@index([workplaceId, category])
  @@map("inventory_items")
}

model Task {
  id            String     @id @default(uuid()) @db.Uuid
  title         String
  description   String?
  status        TaskStatus @default(OPEN)
  priority      Priority   @default(MEDIUM)
  dueAt         DateTime?
  patientId     String?    @db.Uuid
  workplaceId   String?    @db.Uuid
  appointmentId String?    @db.Uuid
  orderId       String?    @db.Uuid
  referralId    String?    @db.Uuid
  followUpId    String?    @db.Uuid
  completedAt   DateTime?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  patient     Patient?            @relation(fields: [patientId], references: [id], onDelete: SetNull)
  workplace   Workplace?          @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  appointment Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  order       InvestigationOrder? @relation(fields: [orderId], references: [id], onDelete: SetNull)
  referral    Referral?           @relation(fields: [referralId], references: [id], onDelete: SetNull)
  followUp    FollowUp?           @relation(fields: [followUpId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]

  @@index([workplaceId, status])
  @@index([patientId])
  @@map("tasks")
}

model TaskAssignee {
  id            String   @id @default(uuid()) @db.Uuid
  taskId        String   @db.Uuid
  userAccountId String   @db.Uuid
  assignedAt    DateTime @default(now())

  task        Task        @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userAccount UserAccount @relation(fields: [userAccountId], references: [id], onDelete: Cascade)

  @@unique([taskId, userAccountId])
  @@map("task_assignees")
}

model Referral {
  id                String         @id @default(uuid()) @db.Uuid
  patientId         String         @db.Uuid
  workplaceId       String?        @db.Uuid
  referringDoctorId String         @db.Uuid
  receivingDoctorId String?        @db.Uuid
  type              ReferralType
  specialty         String?
  referredToName    String
  reason            String
  urgency           Priority       @default(ROUTINE)
  clinicalSummary   String?
  sharedSections    String[]       @default([])
  status            ReferralStatus @default(DRAFT)
  sentAt            DateTime?
  completedAt       DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  patient         Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  workplace       Workplace?     @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  referringDoctor DoctorProfile  @relation("ReferralMadeByDoctor", fields: [referringDoctorId], references: [id], onDelete: Restrict)
  receivingDoctor DoctorProfile? @relation("ReferralReceivedByDoctor", fields: [receivingDoctorId], references: [id], onDelete: SetNull)
  tasks           Task[]
  conversations   Conversation[]

  @@index([patientId])
  @@index([workplaceId, status])
  @@map("referrals")
}

model Conversation {
  id          String           @id @default(uuid()) @db.Uuid
  type        ConversationType
  workplaceId String?          @db.Uuid
  patientId   String?          @db.Uuid
  referralId  String?          @db.Uuid
  title       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  workplace    Workplace?                @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  patient      Patient?                  @relation(fields: [patientId], references: [id], onDelete: SetNull)
  referral     Referral?                 @relation(fields: [referralId], references: [id], onDelete: SetNull)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([workplaceId])
  @@index([patientId])
  @@map("conversations")
}

model ConversationParticipant {
  id              String    @id @default(uuid()) @db.Uuid
  conversationId  String    @db.Uuid
  displayName     String
  participantType String
  userAccountId   String?   @db.Uuid
  lastReadAt      DateTime?
  createdAt       DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  senderUserId   String?  @db.Uuid
  body           String
  attachmentUrl  String?
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       UserAccount? @relation(fields: [senderUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, sentAt])
  @@map("messages")
}

model Notification {
  id              String               @id @default(uuid()) @db.Uuid
  recipientUserId String?              @db.Uuid
  workplaceId     String?              @db.Uuid
  patientId       String?              @db.Uuid
  severity        NotificationSeverity
  category        String
  title           String
  body            String?
  relatedType     String?
  relatedId       String?
  readAt          DateTime?
  createdAt       DateTime             @default(now())

  recipient UserAccount? @relation(fields: [recipientUserId], references: [id], onDelete: Cascade)
  workplace Workplace?   @relation(fields: [workplaceId], references: [id], onDelete: SetNull)
  patient   Patient?     @relation(fields: [patientId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, readAt])
  @@index([workplaceId])
  @@map("notifications")
}

model DoctorContent {
  id          String    @id @default(uuid()) @db.Uuid
  doctorId    String    @db.Uuid
  type        String
  title       String
  body        String?
  mediaUrl    String?
  status      String    @default("DRAFT")
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  doctor DoctorProfile @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId, status])
  @@map("doctor_content")
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  actorUserId String?  @db.Uuid
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  actor UserAccount? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

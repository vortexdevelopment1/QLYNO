generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TenantMode {
  HOSPITAL
  STANDALONE
  B2B
  HYBRID
}
enum AccountStatus {
  PENDING_INVITE
  PENDING_APPROVAL
  ACTIVE
  SUSPENDED
  DEACTIVATED
  REJECTED
}
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}
enum OrderSource {
  HOSPITAL_ENCOUNTER
  WALK_IN
  HOME_COLLECTION
  B2B_CLIENT
  INTERNAL_NO_CHARGE
}
enum BillingAuthority {
  HMS_CENTRAL
  LIS_INTERNAL
  EXTERNAL_CLIENT
  NO_CHARGE
}
enum Priority {
  ROUTINE
  URGENT
  STAT
}
enum OrderStatus {
  DRAFT
  PLACED
  ACCEPTED
  COLLECTED
  IN_PROGRESS
  PARTIALLY_COMPLETED
  COMPLETED
  ON_HOLD
  CANCELLED
}
enum SpecimenStatus {
  EXPECTED
  LABEL_PRINTED
  COLLECTED
  IN_TRANSIT
  RECEIVED
  ACCESSIONED
  ACCEPTED
  REJECTED
  ALIQUOTED
  STORED
  DISPOSED
}
enum TestStatus {
  ORDERED
  READY
  RUNNING
  RESULTED
  TECHNICAL_REVIEW
  MEDICAL_REVIEW
  VERIFIED
  RELEASED
  REPEAT_REQUIRED
  REFLEX_PENDING
  OUTSOURCED
  BLOCKED
}
enum ReportStatus {
  DRAFT
  PRELIMINARY
  FINAL
  CORRECTED
  AMENDED
}
enum BillingStatus {
  ESTIMATE
  INVOICED
  PARTIALLY_PAID
  PAID
  CREDIT
  ADJUSTED
  REFUNDED
}
enum PostingStatus {
  NOT_REQUIRED
  READY_TO_POST
  POSTING
  POSTED
  FAILED
  REVERSED
  RECONCILIATION_REQUIRED
}
enum ManifestStatus {
  BUILDING
  SEALED
  IN_TRANSIT
  DELIVERED
  DELAYED
  LOST
  DAMAGED
}
enum QcStatus {
  IN_CONTROL
  WARNING
  OUT_OF_CONTROL
  REVIEWED
  CLOSED
}
enum Severity {
  MINOR
  MAJOR
  CRITICAL
}
enum IntegrationStatus {
  CONNECTED
  DEGRADED
  DISCONNECTED
}

model Tenant {
  id String @id @default(cuid())
  slug String @unique
  legalName String
  displayName String
  mode TenantMode
  billingEnabled Boolean @default(false)
  accreditation String[]
  logoInitials String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sites Site[]
  departments Department[]
  memberships TenantMembership[]
  userRoles UserRole[]
  userSiteScopes UserSiteScope[]
  userDepartmentScopes UserDepartmentScope[]
  roles Role[]
  patients Patient[]
  patientIdentifiers PatientIdentifier[]
  patientAddresses PatientAddress[]
  patientGuardians PatientGuardian[]
  emergencyContacts EmergencyContact[]
  encounters Encounter[]
  clients ClientOrganization[]
  practitioners Practitioner[]
  catalogItems TestCatalogItem[]
  orders LaboratoryOrder[]
  orderItems LaboratoryOrderItem[]
  containers ContainerType[]
  collectionTasks CollectionTask[]
  specimens Specimen[]
  orderItemSpecimens OrderItemSpecimen[]
  collectionTaskSpecimens CollectionTaskSpecimen[]
  manifestSpecimens ManifestSpecimen[]
  aliquots Aliquot[]
  manifests Manifest[]
  workItems WorkItem[]
  analyzers Analyzer[]
  instrumentRuns InstrumentRun[]
  instrumentRunItems InstrumentRunItem[]
  results Result[]
  resultRevisions ResultRevision[]
  reports Report[]
  reportVersions ReportVersion[]
  reportVersionItems ReportVersionItem[]
  criticalNotifications CriticalNotification[]
  qcRuns QcRun[]
  nonconformances Nonconformance[]
  capas CorrectivePreventiveAction[]
  inventoryItems InventoryItem[]
  stockLots StockLot[]
  stockMovements StockMovement[]
  purchaseOrders PurchaseOrder[]
  purchaseOrderItems PurchaseOrderItem[]
  equipment Equipment[]
  equipmentMaintenance EquipmentMaintenance[]
  estimates Estimate[]
  estimateLines EstimateLine[]
  invoices Invoice[]
  invoiceLines InvoiceLine[]
  payments Payment[]
  refunds Refund[]
  contracts Contract[]
  contractRates ContractRate[]
  chargeLines LaboratoryChargeLine[]
  hmsPostings HospitalBillingPosting[]
  integrations IntegrationConnection[]
  integrationEvents IntegrationEvent[]
  communicationTemplates CommunicationTemplate[]
  communicationDeliveries CommunicationDelivery[]
  supportTickets SupportTicket[]
  auditEvents AuditEvent[]
  qualityDocuments QualityDocument[]
  qualityAudits QualityAudit[]
  competencies CompetencyAssessment[]
  approvals ApprovalRequest[]
  invitations UserInvitation[]
  refreshSessions RefreshSession[]
  authAttempts AuthenticationAttempt[]
  passwordResets PasswordResetToken[]
}

model Site {
  id String @id @default(cuid())
  tenantId String
  code String
  name String
  type String
  city String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  departments Department[]
  memberScopes UserSiteScope[]
  orders LaboratoryOrder[]
  specimens Specimen[]
  collectionTasks CollectionTask[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Department {
  id String @id @default(cuid())
  tenantId String
  siteId String
  code String
  name String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  memberScopes UserDepartmentScope[]
  catalogItems TestCatalogItem[]
  orderItems LaboratoryOrderItem[]
  workItems WorkItem[]
  analyzers Analyzer[]
  @@unique([tenantId, siteId, code])
  @@index([tenantId, siteId])
}

model User {
  id String @id @default(cuid())
  email String @unique
  username String?
  passwordHash String?
  name String
  status AccountStatus @default(PENDING_APPROVAL)
  failedLoginCount Int @default(0)
  lockedUntil DateTime?
  passwordChangedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TenantMembership[]
  invitationsSent UserInvitation[] @relation("InvitationSender")
  approvalsRequested ApprovalRequest[] @relation("ApprovalSubject")
  approvalsReviewed ApprovalRequest[] @relation("ApprovalReviewer")
  refreshSessions RefreshSession[]
  authAttempts AuthenticationAttempt[]
  passwordResets PasswordResetToken[]
  auditEvents AuditEvent[]
  supportTickets SupportTicket[]
  @@index([status])
}

model TenantMembership {
  id String @id @default(cuid())
  tenantId String
  userId String
  clientOrganizationId String?
  practitionerId String?
  isDefault Boolean @default(false)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientOrganization ClientOrganization? @relation(fields: [clientOrganizationId], references: [id], onDelete: Restrict)
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  roles UserRole[]
  siteScopes UserSiteScope[]
  departmentScopes UserDepartmentScope[]
  @@unique([tenantId, userId])
  @@index([tenantId])
}

model Role {
  id String @id @default(cuid())
  tenantId String?
  code String
  name String
  system Boolean @default(false)
  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users UserRole[]
  permissions RolePermission[]
  @@unique([tenantId, code])
  @@index([tenantId])
}

model Permission {
  id String @id @default(cuid())
  code String @unique
  description String
  roles RolePermission[]
}

model UserRole {
  tenantId String
  membershipId String
  roleId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  @@id([membershipId, roleId])
  @@index([tenantId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model UserSiteScope {
  tenantId String
  membershipId String
  siteId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  site Site @relation(fields: [siteId], references: [id], onDelete: Cascade)
  @@id([membershipId, siteId])
  @@index([tenantId])
}

model UserDepartmentScope {
  tenantId String
  membershipId String
  departmentId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  membership TenantMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  @@id([membershipId, departmentId])
  @@index([tenantId])
}

model Patient {
  id String @id @default(cuid())
  tenantId String
  mrn String?
  name String
  dateOfBirth DateTime?
  sex String
  contact String
  source OrderSource
  branchOrWard String?
  privacyFlag Boolean @default(false)
  duplicateWarning Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  identifiers PatientIdentifier[]
  addresses PatientAddress[]
  guardians PatientGuardian[]
  emergencyContacts EmergencyContact[]
  encounters Encounter[]
  orders LaboratoryOrder[]
  specimens Specimen[]
  @@unique([tenantId, mrn])
  @@index([tenantId, name])
}

model PatientIdentifier {
  id String @id @default(cuid())
  tenantId String
  patientId String
  type String
  value String
  issuer String?
  isPrimary Boolean @default(false)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@unique([tenantId, type, value])
  @@index([tenantId, patientId])
}
model PatientAddress {
  id String @id @default(cuid())
  tenantId String
  patientId String
  line1 String?
  line2 String?
  city String?
  state String?
  postalCode String?
  country String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([tenantId, patientId])
}
model PatientGuardian {
  id String @id @default(cuid())
  tenantId String
  patientId String
  fullName String
  relationship String
  mobile String
  authorizedForConsent Boolean @default(false)
  authorizedForReports Boolean @default(false)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([tenantId, patientId])
}
model EmergencyContact {
  id String @id @default(cuid())
  tenantId String
  patientId String
  name String?
  relationship String?
  mobile String?
  notes String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  @@index([tenantId, patientId])
}

model Encounter {
  id String @id @default(cuid())
  tenantId String
  patientId String
  encounterNo String
  ward String?
  bed String?
  admittingDoctor String?
  status String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  orders LaboratoryOrder[]
  @@unique([tenantId, encounterNo])
  @@index([tenantId, patientId])
}

model ClientOrganization {
  id String @id @default(cuid())
  tenantId String
  name String
  type String
  contactPerson String
  contactEmail String
  creditLimit Decimal? @db.Decimal(14,2)
  creditTermsDays Int?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships TenantMembership[]
  orders LaboratoryOrder[]
  contracts Contract[]
  @@index([tenantId, name])
}

model Practitioner {
  id String @id @default(cuid())
  tenantId String
  name String
  specialty String
  clinicOrHospital String
  phone String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  memberships TenantMembership[]
  orders LaboratoryOrder[]
  @@index([tenantId, name])
}

model TestCatalogItem {
  id String @id @default(cuid())
  tenantId String
  departmentId String?
  code String
  name String
  method String
  specimenType String
  containerName String
  minVolume String
  stability String
  tatMinutes Int
  units String
  referenceRange String
  criticalRange String?
  reflexRule String?
  version Int @default(1)
  status String
  effectiveDate DateTime
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  orderItems LaboratoryOrderItem[]
  @@unique([tenantId, code, version])
  @@index([tenantId, status])
}

model LaboratoryOrder {
  id String @id @default(cuid())
  tenantId String
  siteId String
  patientId String
  encounterId String?
  clientOrganizationId String?
  practitionerId String?
  source OrderSource
  billingAuthority BillingAuthority
  priority Priority
  status OrderStatus
  orderingDoctor String
  placedAt DateTime @default(now())
  cancelledAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  encounter Encounter? @relation(fields: [encounterId], references: [id], onDelete: Restrict)
  clientOrganization ClientOrganization? @relation(fields: [clientOrganizationId], references: [id], onDelete: Restrict)
  practitioner Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  items LaboratoryOrderItem[]
  collectionTasks CollectionTask[]
  specimens Specimen[]
  reports Report[]
  estimates Estimate[]
  invoices Invoice[]
  chargeLines LaboratoryChargeLine[]
  hmsPostings HospitalBillingPosting[]
  @@index([tenantId, siteId, status])
  @@index([tenantId, patientId, placedAt])
}

model LaboratoryOrderItem {
  id String @id @default(cuid())
  tenantId String
  orderId String
  testId String
  departmentId String?
  status TestStatus
  reportGroupId String?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  test TestCatalogItem @relation(fields: [testId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  specimenLinks OrderItemSpecimen[]
  workItems WorkItem[]
  results Result[]
  reportVersionItems ReportVersionItem[]
  @@index([tenantId, orderId, status])
}

model ContainerType {
  id String @id @default(cuid())
  tenantId String
  code String
  type String
  color String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  specimens Specimen[]
  @@unique([tenantId, code])
}

model CollectionTask {
  id String @id @default(cuid())
  tenantId String
  siteId String
  orderId String
  encounterId String?
  location String
  priority Priority
  scheduledAt DateTime
  assignedUserId String?
  status String
  collectedAt DateTime?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  order LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  specimens CollectionTaskSpecimen[]
  @@index([tenantId, siteId, status])
}

model Specimen {
  id String @id @default(cuid())
  tenantId String
  siteId String
  orderId String
  patientId String
  containerTypeId String?
  accessionId String?
  type String
  status SpecimenStatus
  collectedAt DateTime?
  collectedById String?
  receivedAt DateTime?
  receivedById String?
  receivedSiteId String?
  collectionCondition String?
  sealStatus String?
  temperature String?
  receiptNotes String?
  rejectedReason String?
  rejectedAt DateTime?
  rejectedById String?
  recollectionOfId String?
  storageLocation String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  site Site @relation(fields: [siteId], references: [id], onDelete: Restrict)
  order LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  patient Patient @relation(fields: [patientId], references: [id], onDelete: Restrict)
  containerType ContainerType? @relation(fields: [containerTypeId], references: [id], onDelete: Restrict)
  recollectionOf Specimen? @relation("SpecimenRecollection", fields: [recollectionOfId], references: [id], onDelete: Restrict)
  recollections Specimen[] @relation("SpecimenRecollection")
  orderItemLinks OrderItemSpecimen[]
  collectionTaskLinks CollectionTaskSpecimen[]
  manifestLinks ManifestSpecimen[]
  aliquots Aliquot[]
  @@unique([tenantId, accessionId])
  @@index([tenantId, siteId, status])
  @@index([tenantId, orderId])
}

model OrderItemSpecimen {
  tenantId String
  orderItemId String
  specimenId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItem LaboratoryOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  specimen Specimen @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  @@id([orderItemId, specimenId])
  @@index([tenantId])
}
model CollectionTaskSpecimen {
  tenantId String
  collectionTaskId String
  specimenId String
  requiredContainer String
  quantity Decimal? @db.Decimal(10,2)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  collectionTask CollectionTask @relation(fields: [collectionTaskId], references: [id], onDelete: Restrict)
  specimen Specimen @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  @@id([collectionTaskId, specimenId])
  @@index([tenantId])
}
model Aliquot {
  id String @id @default(cuid())
  tenantId String
  parentSpecimenId String
  type String
  volume Decimal? @db.Decimal(10,2)
  unit String?
  status SpecimenStatus
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  parentSpecimen Specimen @relation(fields: [parentSpecimenId], references: [id], onDelete: Restrict)
  @@index([tenantId, parentSpecimenId])
}

model Manifest {
  id String @id @default(cuid())
  tenantId String
  route String
  courierName String
  status ManifestStatus
  temperature String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  specimens ManifestSpecimen[]
  @@index([tenantId, status])
}
model ManifestSpecimen {
  tenantId String
  manifestId String
  specimenId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  manifest Manifest @relation(fields: [manifestId], references: [id], onDelete: Restrict)
  specimen Specimen @relation(fields: [specimenId], references: [id], onDelete: Restrict)
  @@id([manifestId, specimenId])
  @@index([tenantId])
}

model WorkItem {
  id String @id @default(cuid())
  tenantId String
  orderItemId String
  departmentId String?
  label String
  priority Priority
  status TestStatus
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItem LaboratoryOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  @@index([tenantId, departmentId, status])
}
model Analyzer {
  id String @id @default(cuid())
  tenantId String
  departmentId String?
  name String
  status String
  lastMessageAt DateTime?
  queueDepth Int @default(0)
  mappingVersion String
  errorCount Int @default(0)
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  department Department? @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  runs InstrumentRun[]
  @@index([tenantId, status])
}
model InstrumentRun {
  id String @id @default(cuid())
  tenantId String
  analyzerId String
  runAt DateTime
  status String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  analyzer Analyzer @relation(fields: [analyzerId], references: [id], onDelete: Restrict)
  items InstrumentRunItem[]
  @@index([tenantId, analyzerId, runAt])
}
model InstrumentRunItem {
  id String @id @default(cuid())
  tenantId String
  instrumentRunId String
  workItemId String?
  rawPayload Json?
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  instrumentRun InstrumentRun @relation(fields: [instrumentRunId], references: [id], onDelete: Restrict)
  @@index([instrumentRunId])
  @@index([tenantId])
}

model Result {
  id String @id @default(cuid())
  tenantId String
  orderItemId String
  testName String
  currentValue String
  units String
  referenceRange String
  flag String
  status TestStatus
  enteredById String?
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  orderItem LaboratoryOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  revisions ResultRevision[]
  @@index([tenantId, orderItemId, status])
}
model ResultRevision {
  id String @id @default(cuid())
  tenantId String
  resultId String
  version Int
  value String
  flag String
  reason String?
  actorUserId String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  result Result @relation(fields: [resultId], references: [id], onDelete: Restrict)
  @@unique([resultId, version])
  @@index([tenantId])
}
model Report {
  id String @id @default(cuid())
  tenantId String
  orderId String
  createdAt DateTime @default(now())
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  order LaboratoryOrder @relation(fields: [orderId], references: [id], onDelete: Restrict)
  versions ReportVersion[]
  @@unique([tenantId, orderId])
}
model ReportVersion {
  id String @id @default(cuid())
  tenantId String
  reportId String
  version Int
  status ReportStatus
  reason String?
  releasedAt DateTime?
  authorizedById String?
  immutableAt DateTime?
  payload Json
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  report Report @relation(fields: [reportId], references: [id], onDelete: Restrict)
  items ReportVersionItem[]
  @@unique([reportId, version])
  @@index([tenantId, status])
}
model ReportVersionItem {
  tenantId String
  reportVersionId String
  orderItemId String
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  reportVersion ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Restrict)
  orderItem LaboratoryOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  @@id([reportVersionId, orderItemId])
  @@index([tenantId])
}
model CriticalNotification {
  id String @id @default(cuid())
  tenantId String
  resultId String?
  patientName String
  testName String
  value String
  notifiedTo String
  acknowledged Boolean @default(false)
  readBackAt DateTime?
  timerSeconds Int
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, acknowledged])
}

model QcRun {
  id String @id @default(cuid())
  tenantId String
  analyte String
  departmentName String
  controlLot String
  level String
  status QcStatus
  westgardViolation String?
  runAt DateTime
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  @@index([tenantId, status, runAt])
}
model Nonconformance {
  id String @id @default(cuid())
  tenantId String
  title String
  category String
  severity Severity
  status String
  raisedAt DateTime
